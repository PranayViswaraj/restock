# ======================================================================
# Restock configuration. Copy to .env and fill in:
#   PowerShell:  Copy-Item .env.example .env
# With NO keys at all the whole app still works (every service has a mock).
# Secrets stay on the server: only PAYPAL_CLIENT_ID is ever sent to the browser.
# ======================================================================

# ---------- Server ----------
PORT=3456
# Re-seed demo data on every start (recommended on Render: its disk resets anyway)
SEED_ON_START=false
# Public URL used in "approve from your phone" QR codes (e.g. https://restock.onrender.com).
# Leave empty to use the address in the browser.
PUBLIC_URL=

# ---------- AI: Scout (free tiers) ----------
# gemini -> https://aistudio.google.com/apikey   (free tier)
# groq   -> https://console.groq.com/keys        (free tier)
LLM_PROVIDER=gemini
# Leave empty for defaults: gemini-2.5-flash / llama-3.3-70b-versatile
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
# true = rule-based Scout instead of an LLM (no key needed)
USE_MOCK_LLM=false
# If the LLM fails mid-run, finish with the rule-based Scout (Guardian applies the same rules)
AGENT_FALLBACK_TO_RULES=true
# Safety cap on tool calls per agent run
AGENT_MAX_TOOL_CALLS=12
# Pause between steps in Demo mode (ms)
DEMO_STEP_DELAY_MS=1100

# ---------- PayPal (SANDBOX only) ----------
# https://developer.paypal.com/dashboard/applications/sandbox -> your app -> Client ID / Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Who receives auto-pay Payouts. Create sandbox PERSONAL accounts at
# https://developer.paypal.com/dashboard/accounts (Create account -> choose the country).
#   SUPPLIER_EMAIL_LOCAL   -> every US supplier (country: United States)
#   SUPPLIER_EMAIL_COORG   -> Coorg Hills Coffee Co-op (country: India)
#   SUPPLIER_EMAIL_CHENNAI -> Chennai EcoPack (country: India)
# Any that are empty fall back to PAYPAL_SUPPLIER_EMAIL (one shared account).
SUPPLIER_EMAIL_LOCAL=
SUPPLIER_EMAIL_COORG=
SUPPLIER_EMAIL_CHENNAI=
PAYPAL_SUPPLIER_EMAIL=
# Optional: sandbox merchant email that receives approval (Orders v2) payments.
# Empty = your app's own sandbox business account receives them.
PAYPAL_ORDER_PAYEE_EMAIL=
# Optional webhooks: Webhook ID from your sandbox app's Webhooks section (URL: <PUBLIC_URL>/api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# true = fake PayPal IDs, no network (also automatic when keys are empty)
USE_MOCK_PAYPAL=false
# true = Scout reads sales from the café's sandbox transactions (Transaction Search API).
# Needs "Transaction search" ticked in your sandbox app's features; new payments can
# take ~3 hours to show up. Falls back to seeded sales (and says so in the UI).
USE_PAYPAL_SALES=false

# ---------- Channel3 product search ----------
# Mock catalog is ON by default. To go live, implement the TODO in
# server/services/channel3.js, then set these:
USE_MOCK_CHANNEL3=true
CHANNEL3_API_KEY=
CHANNEL3_API_BASE=

# ---------- Optional daily agent run ----------
# Recommended on Render: an external scheduler (.github/workflows/daily-agent.yml)
# calls POST /api/cron/daily-run with "Authorization: Bearer <CRON_SECRET>".
# Empty = that endpoint is disabled. Use a long random value.
CRON_SECRET=
# Alternative: in-process timer (only fires while the server is awake)
ENABLE_DAILY_RUN=false
DAILY_RUN_CRON=0 7 * * *
DAILY_RUN_TZ=America/Chicago
